# Local defaults. Do not put production credentials here.
PORT=4102
SWITCHBOARD_DEV_BEARER=switchboard-dev-platform-token
SANDBOX_MAKER_KEY=sandbox-maker-dev
SANDBOX_MAKER_COLLATERAL_USD=1000000
