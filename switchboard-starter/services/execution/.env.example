# Execution service. Copy to .env for a local process. No secrets in this file.
# In-memory store is the default. DATABASE_URL and REDIS_URL are unused by this process.

PORT=4103
SERVICE_VERSION=1.0.0
SWITCHBOARD_DEV_BEARER=switchboard-dev-platform-token

MARKETS_BASE_URL=http://localhost:4102
STRATEGY_BASE_URL=http://localhost:4101
EXECUTION_BASE_URL=http://localhost:4103

# Optional. The service does not open these connections.
DATABASE_URL=postgres://switchboard:localonly@localhost:5432/switchboard
REDIS_URL=redis://localhost:6379

# Deterministic Ed25519 sandbox key. Defaults to ./dev-keys/*.pem when unset.
EXECUTION_AUTH_PRIVATE_KEY_PATH=
EXECUTION_AUTH_PUBLIC_KEY_PATH=

# Must stay false unless a human operator is running a reviewed live path.
EXECUTION_ALLOW_LIVE=false

# Optional JSON ABI. When empty, settlement is a sandbox simulator and cannot report a real tx hash.
EXECUTION_EXCHANGE_ABI_PATH=

XRPL_EVM_CHAIN_ID=1449000
XRPL_EVM_RPC_URL=

AP4M_BASE_URL=https://hackathon.ap4m.build
AP4M_MODE=mock
# Leave empty. Never commit a real agent key. Live mode without this key returns UNVERIFIED.
AP4M_AGENT_PRIVATE_KEY=

LEDGER_MODE=unsupported_until_verified
LEDGER_DMK_VERIFIED=false
