# Copy to local .env only. NEVER commit real keys.
NODE_ENV=development
NEXT_PUBLIC_DEMO_MODE=true
STRATEGY_BASE_URL=http://localhost:4101
MARKETS_BASE_URL=http://localhost:4102
EXECUTION_BASE_URL=http://localhost:4103
DATABASE_URL=postgresql://switchboard:localonly@localhost:5432/switchboard
REDIS_URL=redis://localhost:6379
XRPL_EVM_CHAIN_ID=1449000
XRPL_EVM_RPC_URL=https://rpc.testnet.xrplevm.org
AP4M_BASE_URL=https://hackathon.ap4m.build
AP4M_MODE=mock
# Team name for the AP4M participant portal. The public demo uses Penn when this is unset.
AP4M_TEAM_NAME=Penn
