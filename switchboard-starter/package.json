{
  "name": "switchboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "demo": "tsx server.ts",
    "bundle:demo": "esbuild demo/vercel-entry.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.mjs",
    "test": "pnpm --filter @switchboard/strategy --filter @switchboard/markets --filter @switchboard/execution --filter @switchboard/web test",
    "typecheck": "pnpm --filter @switchboard/strategy --filter @switchboard/markets --filter @switchboard/execution --filter @switchboard/web typecheck",
    "test:contracts": "python tests/validate_starter.py",
    "typecheck:contracts": "pnpm --filter @switchboard/contracts typecheck",
    "ap4m:check": "tsx services/execution/src/ap4m-check.ts",
    "ledger:emulator": "bash ledger/speculos/run.sh",
    "demo:precompute": "tsx demo/precompute.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@ledgerhq/device-management-kit": "^1.11.0",
    "@ledgerhq/device-signer-kit-xrp": "^0.3.0",
    "@ledgerhq/device-transport-kit-speculos": "^1.3.0",
    "canonicalize": "^2.1.0",
    "decimal.js": "^10.5.0",
    "ethers": "6.17.0",
    "fastify": "^5.2.1",
    "jose": "^5.9.6",
    "rxjs": "^7.8.2",
    "xrpl": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2"
  }
}
