{
  "name": "switchboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "demo": "tsx server.ts",
    "bundle:demo": "esbuild demo/vercel-entry.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.mjs",
    "test": "pnpm --filter @switchboard/strategy --filter @switchboard/markets --filter @switchboard/execution --filter @switchboard/web test",
    "typecheck": "pnpm --filter @switchboard/strategy --filter @switchboard/markets --filter @switchboard/execution --filter @switchboard/web typecheck",
    "test:contracts": "python tests/validate_starter.py",
    "typecheck:contracts": "pnpm --filter @switchboard/contracts typecheck"
  },
  "dependencies": {
    "canonicalize": "^2.1.0",
    "decimal.js": "^10.5.0",
    "ethers": "6.17.0",
    "fastify": "^5.2.1",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2"
  }
}
